      "body": {
        "type": "json",
        "raw": "{\n  \"name\": \"Sai Kumar\",\n  \"email\": \"sai.candidate@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"job_seeker\"\n}"
      }
    },
    {
      "_id": "r_auth_login",
      "colId": "col_swipex",
      "containerId": "f_auth",
      "name": "Login User",
      "url": "{{gateway_url}}/api/v1/auth/login",
