        "type": "json",
        "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
      }
    },
    {
      "_id": "r_auth_me",
      "colId": "col_swipex",
      "containerId": "f_auth",
      "name": "Who Am I (/me)",
      "url": "{{gateway_url}}/api/v1/auth/me",
      "method": "GET",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {{access_token}}"
        }
      ]
    },
    {
      "_id": "r_job_list",
      "colId": "col_swipex",
      "containerId": "f_job",
      "name": "List Jobs",
      "url": "{{gateway_url}}/api/v1/jobs",
      "method": "GET"
    },
    {
      "_id": "r_job_filter",
      "colId": "col_swipex",
      "containerId": "f_job",
      "name": "Filter Jobs by Query",
      "url": "{{gateway_url}}/api/v1/jobs?location=Hyderabad&remote=true",
      "method": "GET"
    },
    {
      "_id": "r_job_detail",
      "colId": "col_swipex",
      "containerId": "f_job",
      "name": "Get Job by ID",
      "url": "{{gateway_url}}/api/v1/jobs/{{job_id}}",
      "method": "GET"
    },
    {
      "_id": "r_swipe_record",
      "colId": "col_swipex",
      "containerId": "f_swipe",
      "name": "Record Candidate Swipe",
      "url": "{{gateway_url}}/api/v1/swipes",
      "method": "POST",
      "headers": [
        {
          "name": "Authorization",
          "value": "Bearer {{access_token}}"
        }
      ],
      "body": {
        "type": "json",
        "raw": "{\n  \"job_id\": \"{{job_id}}\",\n  \"direction\": \"right\"\n}"
      }
    },
    {
      "_id": "r_swipe_history",
      "colId": "col_swipex",
      "containerId": "f_swipe",
