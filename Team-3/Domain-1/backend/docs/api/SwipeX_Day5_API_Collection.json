        "type": "json",
        "raw": "{\n  \"email\": \"sai.candidate@example.com\",\n  \"password\": \"Password123!\"\n}"
      }
    },
    {
      "_id": "r_auth_refresh",
      "colId": "col_swipex",
      "containerId": "f_auth",
      "name": "Refresh Access Token",
      "url": "{{gateway_url}}/api/v1/auth/refresh",
