# SwipeX Frontend Environment Variables
# Configurable API base URL for backend services
VITE_API_BASE_URL=/api/v1

# Development Auth Mock Mode:
# Set to 'true' to use the local development mock adapter
# Set to 'false' to connect to the real Intern 1 Auth API
VITE_USE_AUTH_MOCK=false

# Development Jobs & Swipe Mock Mode:
# Set to 'true' to use the local development mock adapter
# Set to 'false' to connect to the real Intern 2 Job & Swipe API
VITE_USE_JOBS_MOCK=false
